# Local test fixtures (per-machine). Copy to `.env` and adjust the paths.
# `.env` is gitignored — never commit real installer paths or credentials.
#
# Source via PowerShell:
#   Get-Content .env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { Set-Item "env:$($matches[1])" $matches[2] } }
# Source via bash:
#   set -a; . ./.env; set +a

# Path to a Linux installer used by the MANUAL.md walkthrough scenarios.
# EXAMPLE_APP_INSTALLER=/path/to/your/example-app-installer
