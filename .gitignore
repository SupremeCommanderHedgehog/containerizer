# Input installers — never commit large binaries we just happen to ingest
*.bin
*.deb
*.rpm
*.AppImage

# Generated containerization artifacts
/out/
**/.intermediates/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
/build/
/dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Claude Code local state (per-developer; do not publish). Ignores the whole
# directory, not just settings.local.json — an unignored .claude/CLAUDE.md was
# sitting untracked here and would have gone in on a `git add .`.
.claude/

# Local env (per-machine test fixtures, installer paths)
.env
.env.local

# Local secrets (API tokens, credentials) — never commit
.secrets/

# Secret material — belt-and-braces for anything the rules above don't name.
*.pem
*.key
*.pfx
*.p12
id_rsa
id_ed25519
secrets.*
credentials.*

# Build/run logs (per-machine diagnostics, not shared)
*.log
