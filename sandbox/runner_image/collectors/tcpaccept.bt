#!/usr/bin/env bpftrace
/*
 * tcpaccept.bt — emit JSONL for every inbound TCP accept().
 *
 * Schema (one JSON object per line):
 *     {ts_ns, pid, comm, family, laddr, lport, raddr, rport}
 *
 * Replaces the bcc-based tcpaccept.py (issue #77 — same kernel-header
 * compile failure as tcpconnect.py). See tcpconnect.bt for the root-
 * cause notes.
 *
 * Probe:
 *   kretprobe:inet_csk_accept — fires when accept(2) returns. retval is
 *   the new struct sock *; NULL means accept failed and we skip.
 */

kretprobe:inet_csk_accept
{
    $sk = (struct sock *)retval;
    if ($sk == 0) { return; }

    $family = $sk->__sk_common.skc_family;
    $lport = (uint32)$sk->__sk_common.skc_num;
    $rport_be = (uint32)$sk->__sk_common.skc_dport;
    $rport = ($rport_be >> 8) | (($rport_be & 0xff) << 8);

    if ($family == AF_INET) {
        printf("{\"ts_ns\":%lld,\"pid\":%d,\"comm\":\"%s\",\"family\":%d,\"laddr\":\"%s\",\"lport\":%d,\"raddr\":\"%s\",\"rport\":%d}\n",
            nsecs, pid, comm, $family,
            ntop(AF_INET, $sk->__sk_common.skc_rcv_saddr), $lport,
            ntop(AF_INET, $sk->__sk_common.skc_daddr), $rport);
    } else if ($family == AF_INET6) {
        printf("{\"ts_ns\":%lld,\"pid\":%d,\"comm\":\"%s\",\"family\":%d,\"laddr\":\"%s\",\"lport\":%d,\"raddr\":\"%s\",\"rport\":%d}\n",
            nsecs, pid, comm, $family,
            ntop(AF_INET6, $sk->__sk_common.skc_v6_rcv_saddr.in6_u.u6_addr8), $lport,
            ntop(AF_INET6, $sk->__sk_common.skc_v6_daddr.in6_u.u6_addr8), $rport);
    }
}
