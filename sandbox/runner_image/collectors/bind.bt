#!/usr/bin/env bpftrace
/*
 * bind.bt — emits {ts_ns, pid, comm, family, addr, port, proto} JSONL for
 * every bind(2) syscall. Captures IPv4, IPv6, and AF_UNIX in one stream.
 *
 * proto is "tcp" if the socket was SOCK_STREAM at bind, "udp" if SOCK_DGRAM,
 * "unix" if AF_UNIX, "?" otherwise.
 *
 * We track the socket type in a map keyed on (pid << 32 | fd) so it survives
 * across syscalls. The map is populated at sys_exit_socket (when the returned
 * fd becomes known), read at sys_enter_bind (via args->fd), and freed at
 * sys_enter_close. Keying on tid would not work: sys_exit_socket always fires
 * before the subsequent bind(), so a tid-keyed entry deleted at exit_socket
 * would always be gone by the time bind reads it.
 */

#include <linux/in.h>
#include <linux/in6.h>
#include <linux/un.h>

tracepoint:syscalls:sys_enter_socket
{
    @pending_type[tid] = args->type & 0xf;  // SOCK_STREAM=1, SOCK_DGRAM=2
}

tracepoint:syscalls:sys_exit_socket
/ @pending_type[tid] /
{
    if (args->ret >= 0) {
        $key = (((uint64)pid) << 32) | (uint32)args->ret;
        @sock_type[$key] = @pending_type[tid];
    }
    delete(@pending_type[tid]);
}

tracepoint:syscalls:sys_enter_close
{
    $key = (((uint64)pid) << 32) | (uint32)args->fd;
    delete(@sock_type[$key]);
}

tracepoint:syscalls:sys_enter_bind
{
    $umyaddr = (struct sockaddr *)args->umyaddr;
    $family = $umyaddr->sa_family;

    // bpftrace's strict typing won't let a single variable hold both
    // string and inet (ntop) types, so emit one printf per family branch.
    $key = (((uint64)pid) << 32) | (uint32)args->fd;
    $stype = @sock_type[$key];

    if ($family == AF_INET) {
        $sin = (struct sockaddr_in *)$umyaddr;
        $port = ($sin->sin_port >> 8) | (($sin->sin_port & 0xff) << 8);
        $proto4 = "?";
        if ($stype == 1) { $proto4 = "tcp"; }
        else if ($stype == 2) { $proto4 = "udp"; }
        printf("{\"ts_ns\":%lld,\"pid\":%d,\"comm\":\"%s\",\"family\":%d,\"addr\":\"%s\",\"port\":%d,\"proto\":\"%s\"}\n",
            nsecs, pid, comm, $family, ntop(AF_INET, $sin->sin_addr.s_addr), $port, $proto4);
    } else if ($family == AF_INET6) {
        $sin6 = (struct sockaddr_in6 *)$umyaddr;
        $port6 = ($sin6->sin6_port >> 8) | (($sin6->sin6_port & 0xff) << 8);
        $proto6 = "?";
        if ($stype == 1) { $proto6 = "tcp"; }
        else if ($stype == 2) { $proto6 = "udp"; }
        printf("{\"ts_ns\":%lld,\"pid\":%d,\"comm\":\"%s\",\"family\":%d,\"addr\":\"%s\",\"port\":%d,\"proto\":\"%s\"}\n",
            nsecs, pid, comm, $family, ntop(AF_INET6, $sin6->sin6_addr.in6_u.u6_addr8), $port6, $proto6);
    } else if ($family == AF_UNIX) {
        $sun = (struct sockaddr_un *)$umyaddr;
        printf("{\"ts_ns\":%lld,\"pid\":%d,\"comm\":\"%s\",\"family\":%d,\"addr\":\"%s\",\"port\":%d,\"proto\":\"%s\"}\n",
            nsecs, pid, comm, $family, $sun->sun_path, 0, "unix");
    }
}
