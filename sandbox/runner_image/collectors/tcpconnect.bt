#!/usr/bin/env bpftrace
/*
 * tcpconnect.bt — emit JSONL for every outbound TCP connect().
 *
 * Schema (one JSON object per line):
 *     {ts_ns, pid, comm, family, saddr, sport, daddr, dport}
 *
 * Replaces the bcc-based tcpconnect.py (issue #77 — bcc fails to
 * preprocess <net/sock.h> on Ubuntu 6.17 runner kernel-headers because
 * include/linux/bpf.h does sizeof(struct bpf_wq) on a type whose full
 * definition lives in kernel/bpf/helpers.c; clang outside the kernel
 * build can't complete it). bpftrace resolves struct sock layout from
 * /sys/kernel/btf/vmlinux directly, so we never need to pull in the
 * broken kernel header.
 *
 * linux/in.h is included for the AF_INET / AF_INET6 numeric defines
 * that ntop() expects. It's a small UAPI header that does NOT pull in
 * the broken include/linux/bpf.h chain (that's <net/sock.h>).
 *
 * Save sk at entry, read at return:
 *   At kprobe (entry) the kernel has NOT yet populated the source/dest
 *   fields of struct sock; reading skc_rcv_saddr etc. there yields all
 *   zeros. We stash arg0 in @sk[tid] and read it back at kretprobe,
 *   when the kernel has filled the struct. This matches the upstream
 *   bpftrace tools/tcpconnect.bt pattern.
 */

#include <linux/in.h>
#include <linux/in6.h>

kprobe:tcp_v4_connect,
kprobe:tcp_v6_connect
{
    @sk[tid] = (struct sock *)arg0;
}

kretprobe:tcp_v4_connect,
kretprobe:tcp_v6_connect
/ @sk[tid] /
{
    $sk = @sk[tid];
    $family = $sk->__sk_common.skc_family;
    $sport = $sk->__sk_common.skc_num;
    $dport = bswap($sk->__sk_common.skc_dport);

    if ($family == AF_INET) {
        printf("{\"ts_ns\":%lld,\"pid\":%d,\"comm\":\"%s\",\"family\":%d,\"saddr\":\"%s\",\"sport\":%d,\"daddr\":\"%s\",\"dport\":%d}\n",
            nsecs, pid, comm, $family,
            ntop(AF_INET, $sk->__sk_common.skc_rcv_saddr), $sport,
            ntop(AF_INET, $sk->__sk_common.skc_daddr), $dport);
    } else if ($family == AF_INET6) {
        printf("{\"ts_ns\":%lld,\"pid\":%d,\"comm\":\"%s\",\"family\":%d,\"saddr\":\"%s\",\"sport\":%d,\"daddr\":\"%s\",\"dport\":%d}\n",
            nsecs, pid, comm, $family,
            ntop(AF_INET6, $sk->__sk_common.skc_v6_rcv_saddr.in6_u.u6_addr8), $sport,
            ntop(AF_INET6, $sk->__sk_common.skc_v6_daddr.in6_u.u6_addr8), $dport);
    }
    delete(@sk[tid]);
}
